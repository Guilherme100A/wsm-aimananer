{
  "name": "@wsm/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --target node20 --platform node --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@wsm/core": "workspace:*",
    "@wsm/db": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6"
  }
}
