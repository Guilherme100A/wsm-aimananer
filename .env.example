# Copie para .env e preencha. Nunca versione valores reais.

# PostgreSQL / Redis (valores de desenvolvimento local)
DATABASE_URL=postgres://wsm:wsm@localhost:5432/wsm
REDIS_URL=redis://localhost:6379

# Token Bearer da API (gere um valor aleatório longo)
API_TOKEN=change-me
# Chave de cifragem das credenciais do WhatsApp: 32 bytes em base64 (ex.: openssl rand -base64 32)
CREDENTIALS_KEY=change-me-32-bytes-base64

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# IA (opcional)
AI_PROVIDER_API_KEY=
AI_MODEL_SMALL=claude-haiku-4-5-20251001
AI_MODEL_LARGE=claude-sonnet-5

# Alertas por e-mail (opcional), ex.: smtp://user:pass@smtp.example.com:587
SMTP_URL=

# T10 — cronograma de warm-up (defaults do baileys-antiban)
WARMUP_DAYS=7
WARMUP_DAY1_LIMIT=20
WARMUP_GROWTH_FACTOR=1.8

# T11 — janela de deduplicação de alertas por (evento, sessão), em ms (default 10 min)
ALERT_DEDUP_MS=600000

# T09 — antiban (baileys-antiban). ANTIBAN_MODE=real (default) | passthrough (SOMENTE testes).
# ANTIBAN_PRESET=conservative (default) | moderate | aggressive | high-volume. Ver docs/antiban.md.
ANTIBAN_MODE=real
ANTIBAN_PRESET=conservative

# T13 — roteador da IA: large só quando a confiança do small < limiar; limite de tokens e timeout por chamada
AI_CONFIDENCE_THRESHOLD=0.6
AI_MAX_TOKENS=512
AI_TIMEOUT_MS=10000
